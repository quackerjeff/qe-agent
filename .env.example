# QE Agent — local environment configuration
#
# Copy this file to `.env` (git-ignored) and fill in values for your
# environment. Addresses, keys, and model names must NEVER be committed
# to the repository.
#
# Precedence: real environment variables > this .env file.

# --- Model provider -----------------------------------------------------
# API key for the model provider. Not required when pointing at a local
# OpenAI-compatible endpoint that ignores auth.
# OPENAI_API_KEY=sk-your-key-here

# --- Local OpenAI-compatible endpoint (optional) -----------------------
# Overrides `model.baseUrl` in .qe/config.yml so committed config can
# stay free of addresses.
# QE_MODEL_BASE_URL=http://your-local-endpoint:port/v1

# Overrides `model.model` in .qe/config.yml so committed config can stay
# free of environment-specific model names.
# QE_MODEL=your-local-model-name

# --- OpenCode harness integration ---------------------------------------
# Base URL of a running OpenCode server (opencode serve).
# OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Target OpenCode session for `qe opencode publish` delivery.
# QE_OPENCODE_SESSION_ID=

# Basic-auth credentials when the OpenCode server is protected
# (OPENCODE_SERVER_PASSWORD). The password is treated as a known
# secret and redacted from all QE output and artifacts.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# --- GitHub integration --------------------------------------------------
# GitHub token for `qe github publish`. Treated as a known secret.
# GITHUB_TOKEN=
# --- Kiro harness integration -------------------------------------------
# The kiro-cli executable is resolved from PATH. Kiro authentication is
# handled by `kiro-cli` itself (Builder ID / IAM / API key per Kiro docs).
# qe kiro publish needs no additional credentials here.
