dist/
build/
*.tsbuildinfo

vitest.config.ts.timestamp-*.mjs


# =============================================================================
# Test / coverage output
# =============================================================================

coverage/
.nyc_output/


# =============================================================================
# QE Agent runtime artifacts
#
# IMPORTANT:
# .qe/ itself is intentionally NOT ignored.
# Durable QE configuration and project knowledge may be committed.
# =============================================================================

# QE runtime/generated state
.qe/TESTING.md
.qe/RISKS.md
.qe/HISTORY.md
.qe/knowledge/
.qe/runs/
.qe/cache/
.qe/artifacts/
.qe/screenshots/tmp/
.qe/traces/

# Keep QE configuration
!.qe/config.yml


# =============================================================================
# Local AI-agent / development-tool state
# =============================================================================

.claude/
.cursor/
.copilot/


# =============================================================================
