{
  "name": "qe-agent",
  "version": "0.1.0",
  "description": "Autonomous Quality Engineering Agent",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "qe": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "keywords": [
    "quality-engineering",
    "testing",
    "automation",
    "ai"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.8.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "openai": "^7.4.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  }
}
